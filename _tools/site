#!/usr/bin/env bash
#
# Build, preview, check and deploy andywhite.org.
#
# Uses only tools macOS ships with. Hugo itself is fetched on first use, at the
# exact version named in .hugo-version, and cached in bin/.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PUBLIC="$ROOT/public"
HUGO=""
tmp=""

# shellcheck source=image-limits
source "$ROOT/_tools/image-limits"

die() {
  echo "site: $*" >&2
  exit 1
}

usage() {
  cat >&2 <<EOF
Usage: _tools/site <command>

Commands:
  serve   Preview the site locally, including drafts
  build   Build the site into public/
  check   Verify the built site in public/

serve and build first shrink, in place, any image in content/ or static/ over
the limits in _tools/image-limits.
EOF
  exit 1
}

# Points git at the versioned hooks in .githooks/, so a fresh clone gets them
# without any setup.
enable_hooks() {
  git -C "$ROOT" rev-parse --git-dir > /dev/null 2>&1 || return 0
  [[ "$(git -C "$ROOT" config core.hooksPath || true)" == ".githooks" ]] && return
  git -C "$ROOT" config core.hooksPath .githooks
  echo "Enabled the git hooks in .githooks/" >&2
}

require_sips() {
  command -v sips > /dev/null || die "this script needs macOS (sips is missing)"
}

# Shrinks, in place, any image in content/ or static/ over the limits in
# image-limits. sips can't write WebP or GIF, so those are only reported.
shrink_images() {
  require_sips
  local file name before
  while IFS= read -r -d '' file; do
    is_oversized "$file" || continue
    name="${file#"$ROOT"/}"
    before="$(describe_image "$file")"
    case "$(echo "$file" | tr '[:upper:]' '[:lower:]')" in
      *.jpg | *.jpeg)
        if (( $(long_edge "$file") > MAX_EDGE )); then
          sips -Z "$MAX_EDGE" -s formatOptions 80 "$file" > /dev/null
        else
          sips -s formatOptions 80 "$file" > /dev/null
        fi
        ;;
      *.png)
        # sips -Z also enlarges, so only resize images that are too big.
        (( $(long_edge "$file") > MAX_EDGE )) && sips -Z "$MAX_EDGE" "$file" > /dev/null
        ;;
    esac
    if [[ "$(describe_image "$file")" != "$before" ]]; then
      echo "shrunk: $name ($before -> $(describe_image "$file"))"
    fi
    if is_oversized "$file"; then
      echo "still too large: $name ($(describe_image "$file")); resize it, or save it as JPEG" >&2
    fi
  done < <(find "$ROOT/content" "$ROOT/static" -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
    -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' \) -print0)
}

# Sets HUGO to the pinned Hugo binary, downloading it first if it isn't cached.
# Hugo's macOS releases are signed installer packages; the binary is unpacked
# from the package rather than installed, so nothing outside bin/ changes.
ensure_hugo() {
  local version dir url
  [[ -f "$ROOT/.hugo-version" ]] || die ".hugo-version is missing"
  version="$(tr -d '[:space:]' < "$ROOT/.hugo-version")"
  [[ -n "$version" ]] || die ".hugo-version is empty"

  dir="$ROOT/bin/hugo-$version"
  HUGO="$dir/hugo"
  [[ -x "$HUGO" ]] && return

  url="https://github.com/gohugoio/hugo/releases/download/v$version/hugo_${version}_darwin-universal.pkg"
  echo "Downloading Hugo $version..." >&2
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT

  curl -fL --progress-bar -o "$tmp/hugo.pkg" "$url" \
    || die "couldn't download Hugo $version from $url"
  pkgutil --check-signature "$tmp/hugo.pkg" > /dev/null \
    || die "the Hugo $version package isn't signed; not using it"
  pkgutil --expand-full "$tmp/hugo.pkg" "$tmp/pkg" > /dev/null \
    || die "couldn't unpack the Hugo $version package"
  [[ -f "$tmp/pkg/Payload/hugo" ]] || die "no hugo binary in the Hugo $version package"

  mkdir -p "$dir"
  mv "$tmp/pkg/Payload/hugo" "$HUGO"
  chmod +x "$HUGO"
  "$HUGO" version >&2
}

cmd_build() {
  ensure_hugo
  shrink_images
  HUGO_ENVIRONMENT=production "$HUGO" --source "$ROOT" --destination "$PUBLIC" \
    --cleanDestinationDir --minify
}

cmd_serve() {
  ensure_hugo
  shrink_images
  "$HUGO" server --source "$ROOT" --buildDrafts
}

# Checks run against public/. Each prints its own failures and returns non-zero
# if anything is wrong; add new ones to CHECKS.

check_required_files() {
  local ok=0 file
  for file in index.html feed.xml sitemap.xml; do
    if [[ ! -f "$PUBLIC/$file" ]]; then
      echo "missing: public/$file"
      ok=1
    fi
  done
  return $ok
}

# Every URL in expected-paths.txt exists in public/. Redirect entries must be
# Hugo alias pages whose refresh target is the expected URL.
check_url_parity() {
  local ok=0 line path target file base
  base="$(sed -n 's/^baseURL *= *"\(.*\)"$/\1/p' "$ROOT/hugo.toml")"
  base="${base%/}"
  [[ -n "$base" ]] || { echo "no baseURL in hugo.toml"; return 1; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    path="${line%% -> *}"
    target=""
    [[ "$line" == *" -> "* ]] && target="${line#* -> }"

    file="$PUBLIC$path"
    [[ "$path" == */ ]] && file="${file}index.html"
    if [[ ! -f "$file" ]]; then
      echo "missing: $path (public${file#"$PUBLIC"})"
      ok=1
    elif [[ -n "$target" ]] \
      && ! grep -qF "content=\"0; url=$base$target\"" "$file"; then
      echo "not a redirect to $target: $path"
      ok=1
    fi
  done < "$ROOT/_tools/expected-paths.txt"
  return $ok
}

# Prints the permalink of each blog post Hugo lists as $1 (drafts or published).
post_permalinks() {
  "$HUGO" list "$1" --source "$ROOT" | grep -oE 'https?://[^,"]+,page,blog$' \
    | sed 's/,page,blog$//'
}

# No draft post is in public/, the feed or the sitemap.
check_no_drafts() {
  local ok=0 url path
  while IFS= read -r url; do
    path="/${url#*://*/}"
    if [[ -e "$PUBLIC$path" ]] || grep -qF "$url" "$PUBLIC/feed.xml" "$PUBLIC/sitemap.xml"; then
      echo "draft published: $path"
      ok=1
    fi
  done < <(post_permalinks drafts)
  return $ok
}

# The feed lists every published post, and nothing else, and has no email.
check_feed() {
  local ok=0 url posts items
  posts=0
  while IFS= read -r url; do
    posts=$((posts + 1))
    if ! grep -qF "<link>$url</link>" "$PUBLIC/feed.xml"; then
      echo "not in feed: $url"
      ok=1
    fi
  done < <(post_permalinks published)
  items="$(grep -o '<item>' "$PUBLIC/feed.xml" | wc -l | tr -d ' ')"
  if (( items != posts )); then
    echo "feed has $items items, expected $posts"
    ok=1
  fi
  if grep -qE '<(email|managingEditor|webMaster)>|<author>[^<]*@' "$PUBLIC/feed.xml"; then
    echo "feed contains an email address"
    ok=1
  fi
  return $ok
}

# Prints "public/<file>" for each file in $1, indented, after the heading $2.
report_files() {
  [[ -z "$1" ]] && return 0
  echo "$2"
  echo "$1" | sed "s|^$PUBLIC|  public|"
  return 1
}

check_no_scripts() {
  report_files "$(grep -rl '<script' "$PUBLIC" --include='*.html' || true)" \
    "script tags in:"
}

# No email address is published, in any file.
check_no_email() {
  report_files "$(grep -rliE 'mailto:|andy@andywhite\.org' "$PUBLIC" || true)" \
    "email addresses in:"
}

# Pages load nothing from another site: no scripts, stylesheets, fonts, images
# or frames. Ordinary outbound links are fine. The minifier drops attribute
# quotes, so quotes are optional in the patterns.
check_no_third_party_resources() {
  local own='^(https:)?//andywhite[.]org(/|$)' url='(https?:)?//[^"'"'"' >)]+' found
  found="$(
    {
      grep -roE "(src|srcset|poster|data)=[\"']?$url" "$PUBLIC" --include='*.html'
      grep -roE "<link[^>]* href=[\"']?$url" "$PUBLIC" --include='*.html'
      grep -roE "url\([\"']?$url" "$PUBLIC" --include='*.html' --include='*.css'
      grep -roE '@import[^;]*' "$PUBLIC" --include='*.css'
    } | sed -E "s/:(src|srcset|poster|data)=[\"']?/:/; s/:<link.* href=[\"']?/:/; s/:url\([\"']?/:/" \
      | awk -F: -v own="$own" '{ u = substr($0, index($0, ":") + 1) } u !~ own' \
      || true
  )"
  [[ -z "$found" ]] && return 0
  echo "third-party resources:"
  echo "$found" | sed "s|^$PUBLIC|  public|"
  return 1
}

CHECKS=(
  check_required_files
  check_url_parity
  check_no_drafts
  check_feed
  check_no_scripts
  check_no_email
  check_no_third_party_resources
)

cmd_check() {
  [[ -d "$PUBLIC" ]] || die "public/ doesn't exist; run _tools/site build first"
  ensure_hugo
  local failed=0 check
  for check in "${CHECKS[@]}"; do
    "$check" || failed=1
  done
  if (( failed )); then
    echo "check failed" >&2
    exit 1
  fi
  echo "check passed"
}

case "${1:-}" in
  serve | build | check) enable_hooks ;;
esac

case "${1:-}" in
  serve) cmd_serve ;;
  build) cmd_build ;;
  check) cmd_check ;;
  *) usage ;;
esac
